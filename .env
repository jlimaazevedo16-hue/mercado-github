# ===============================
# APLICAÇÃO
# ===============================
NODE_ENV=production
APP_NAME=mercado-digital
APP_ENV=production
APP_URL=https://seudominio.com
PORT=3000

# ===============================
# SUPABASE (OBRIGATÓRIO NA PRIMEIRA ATIVAÇÃO)
# ===============================
VITE_SUPABASE_URL=https://SEU_PROJECT_ID.supabase.co
VITE_SUPABASE_ANON_KEY=SUPABASE_ANON_KEY_AQUI

SUPABASE_URL=https://SEU_PROJECT_ID.supabase.co
SUPABASE_ANON_KEY=SUPABASE_ANON_KEY_AQUI
SUPABASE_SERVICE_ROLE_KEY=SUPABASE_SERVICE_ROLE_KEY_AQUI

# ===============================
# AUTH / SEGURANÇA
# ===============================
JWT_SECRET=GERAR_UMA_CHAVE_FORTE_AQUI
SESSION_EXPIRATION_MINUTES=1440

# ===============================
# E-MAIL (RESEND)
# ===============================
RESEND_API_KEY=RESEND_API_KEY_AQUI
EMAIL_FROM_NAME=Associação dos Mercados Municipais
EMAIL_FROM_ADDRESS=nao-responda@seudominio.com
EMAIL_REPLY_TO=contato@seudominio.com

# ===============================
# WHATSAPP (EVOLUTION API)
# ===============================
EVOLUTION_API_URL=https://sua-vps:porta
EVOLUTION_API_KEY=EVOLUTION_API_KEY_AQUI
EVOLUTION_INSTANCE_NAME=mercado-digital
EVOLUTION_WEBHOOK_SECRET=GERAR_SECRET_AQUI

# ===============================
# IA ASSISTENTE (GEMINI)
# ===============================
GEMINI_API_KEY=GEMINI_API_KEY_AQUI
GEMINI_ENABLED=true

# ===============================
# FINANCEIRO
# ===============================
UFMS_VALOR_PADRAO=4.5971
COBRANCA_MINIMA_TOTAL=50.00
MOEDA_PADRAO=BRL

# ===============================
# STORAGE / UPLOAD
# ===============================
MAX_UPLOAD_SIZE_MB=10
UPLOAD_ALLOWED_TYPES=jpg,jpeg,png,pdf
STORAGE_BUCKET=documentos

# ===============================
# LOGS / AUDITORIA
# ===============================
AUDIT_LOG_ENABLED=true
LOG_LEVEL=info

# ===============================
# CORS / SEGURANÇA
# ===============================
CORS_ALLOWED_ORIGINS=https://seudominio.com
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60

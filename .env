# ===============================
# APLICAÇÃO
# ===============================
APP_NAME=Mercado_Municipal_Digital
APP_ENV=production
APP_URL=http://localhost:3000
APP_PORT=3000

# ===============================
# SUPABASE
# ===============================
SUPABASE_URL=https://SEU_PROJECT_ID.supabase.co
SUPABASE_ANON_KEY=SUPABASE_ANON_KEY_AQUI
SUPABASE_SERVICE_ROLE_KEY=SUPABASE_SERVICE_ROLE_KEY_AQUI

# ===============================
# AUTENTICAÇÃO
# ===============================
AUTH_LOGIN_MODE=email_or_cpf
AUTH_ENABLE_RESET_PASSWORD=true

# ===============================
# EMAIL (RESEND)
# ===============================
RESEND_API_KEY=RESEND_API_KEY_AQUI
EMAIL_FROM_NAME=Associação do Mercado Municipal
EMAIL_FROM_ADDRESS=naoresponder@seudominio.com

# ===============================
# WHATSAPP (EVOLUTION API)
# ===============================
EVOLUTION_API_URL=http://SEU_SERVIDOR:PORTA
EVOLUTION_API_KEY=EVOLUTION_API_KEY_AQUI
EVOLUTION_INSTANCE_NAME=mercado_municipal
WHATSAPP_ENABLE_QUEUE=true
WHATSAPP_BATCH_LIMIT=30
WHATSAPP_BATCH_DELAY_SECONDS=300

# ===============================
# IA ASSISTENTE (GEMINI)
# ===============================
GEMINI_API_KEY=GEMINI_API_KEY_AQUI
GEMINI_ENABLED=true
GEMINI_ALLOWED_ROLES=administrador,administrador_master

# ===============================
# FINANCEIRO
# ===============================
UFMS_VALOR_PADRAO=3.76
FINANCEIRO_MOEDA=BRL
FINANCEIRO_MIN_COBRANCA=50.00

# ===============================
# UPLOADS / STORAGE
# ===============================
UPLOAD_MAX_SIZE_MB=10
UPLOAD_ALLOWED_TYPES=pdf,jpg,jpeg,png

# ===============================
# SEGURANÇA
# ===============================
CORS_ALLOWED_ORIGINS=http://localhost:3000
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=120

# ===============================
# LOGS
# ===============================
LOG_LEVEL=info
AUDIT_LOG_ENABLED=true
